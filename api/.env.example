# Локально: обычный Postgres. На Vercel: пулированная строка Neon.
DATABASE_URL=postgresql+asyncpg://localhost:5432/body_training

# Пустой токен = проверка выключена (локальная разработка).
# В облаке обязателен.
API_TOKEN=

# Origins, которым разрешён доступ. app://tracker — бандл внутри macOS-приложения.
CORS_ORIGINS=http://localhost:5173,http://localhost:4317,app://tracker

# true на Vercel: соединения не пулируются в процессе, пул на стороне Neon.
SERVERLESS=false
